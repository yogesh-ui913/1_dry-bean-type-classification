def get_metrics(model, name):
    y_pred_test = model.predict(X_test)
    y_pred_train = model.predict(X_train)

    test_acc = accuracy_score(y_test, y_pred_test)
    train_acc = accuracy_score(y_train, y_pred_train)
    f1 = f1_score(y_test, y_pred_test, average='weighted')

    diff = train_acc - test_acc
    overfitting = "Yes" if diff > 0.02 else "No"

    return {
        'Model': name,
        'Train Accuracy': train_acc,
        'Test Accuracy': test_acc,
        'F1 Score': f1,
        'Overfitting (Y/N)': overfitting
    }

# Collect data for all models
comparison_data = [
    get_metrics(log_reg_model, 'Logistic Regression'),
    get_metrics(dt_model, 'Decision Tree'),
    get_metrics(knn_model, 'KNN'),
    get_metrics(svm_model, 'SVM (Base)'),
]

# Conditionally add tuned SVM if available
if 'best_svm' in globals():
    comparison_data.append(get_metrics(best_svm, 'SVM (Tuned)'))
else:
    print("Warning: 'best_svm' not found. Skipping SVM (Tuned) from comparison.")

comparison_data.append(get_metrics(rf_model, 'Random Forest (Base)'))

# Conditionally add tuned Random Forest if available
if 'best_rf_tuned' in globals():
    comparison_data.append(get_metrics(best_rf_tuned, 'Random Forest (Tuned)'))
else:
    print("Warning: 'best_rf_tuned' not found. Skipping Random Forest (Tuned) from comparison.")

comparison_data.append(get_metrics(xgb_model, 'XGBoost (Base)'))

# Conditionally add tuned XGBoost if available
if 'best_xgb' in globals():
    comparison_data.append(get_metrics(best_xgb, 'XGBoost (Tuned)'))
else:
    print("Warning: 'best_xgb' not found. Skipping XGBoost (Tuned) from comparison.")


# Create DataFrame
comparison_df = pd.DataFrame(comparison_data)

# Find the best model based on F1 Score
best_model_idx = comparison_df['F1 Score'].idxmax()
best_model_name = comparison_df.loc[best_model_idx, 'Model']

print("### 9. Model Comparison Table")
display(comparison_df.style.format({
    'Train Accuracy': '{:.4f}',
    'Test Accuracy': '{:.4f}',
    'F1 Score': '{:.4f}'
}).highlight_max(subset=['F1 Score'], color='lightgreen'))

print(f"\n**Best Model:** {best_model_name}")

