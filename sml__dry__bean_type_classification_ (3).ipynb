from sklearn.model_selection import GridSearchCV
from sklearn.svm import SVC
from sklearn.metrics import classification_report, accuracy_score
import time
import pandas as pd
import numpy as np
from scipy.stats import yeojohnson
from sklearn.preprocessing import RobustScaler, LabelEncoder
from imblearn.over_sampling import SMOTE
from sklearn.model_selection import train_test_split

print("### Hyperparameter Tuning for SVM Classifier (GridSearchCV) ###")

# --- Re-execute necessary preprocessing and data splitting to define X_train, y_train ---
# 1. Load the original dataset
df_raw = pd.read_excel('dry Beans Multiclass Classification (1).xlsx')

# 2. Apply Yeo-Johnson transformation
numerical_features = df_raw.select_dtypes(include=np.number).columns.tolist()
for feature in numerical_features:
    df_raw[feature], _ = yeojohnson(df_raw[feature])

# 3. IQR Outlier Removal
df_cleaned_temp = df_raw.copy()
for col in numerical_features:
    Q1 = df_cleaned_temp[col].quantile(0.25)
    Q3 = df_cleaned_temp[col].quantile(0.75)
    IQR = Q3 - Q1
    df_cleaned_temp = df_cleaned_temp[(df_cleaned_temp[col] >= Q1 - 1.5 * IQR) & (df_cleaned_temp[col] <= Q3 + 1.5 * IQR)]

# 4. Drop problematic columns
df_cleaned_temp = df_cleaned_temp.drop(columns=['Solidity', 'ShapeFactor4'])

# 5. Separate features (X) and target variable (y)
X_temp = df_cleaned_temp.drop('Class', axis=1)
y_temp = df_cleaned_temp['Class']

# 6. Scaling
scaler = RobustScaler()
X_scaled_temp = X_temp.copy()
X_scaled_temp[X_temp.columns] = scaler.fit_transform(X_temp)

# 7. Label Encoding
label_encoder = LabelEncoder() # Ensure label_encoder is defined for classification_report
y_encoded_temp = label_encoder.fit_transform(y_temp)

# 8. SMOTE
smote = SMOTE(random_state=42)
X_resampled_temp, y_resampled_temp = smote.fit_resample(X_scaled_temp, y_encoded_temp)

# 9. Train-Test Split
X_train, X_test, y_train, y_test = train_test_split(
    X_resampled_temp, y_resampled_temp, test_size=0.2, random_state=42, stratify=y_resampled_temp
)
# --- End of data preparation ---

# Define a parameter grid for SVM. Focusing on C and kernel.
# You might expand this with 'gamma' for 'rbf' kernel if performance needs further improvement.
param_grid_svm = {
    'C': [0.1, 1, 10],
    'kernel': ['linear', 'rbf']
}

# Initialize SVM base model
svm_base = SVC(random_state=42)

# Initialize GridSearchCV
grid_search_svm = GridSearchCV(estimator=svm_base, param_grid=param_grid_svm, scoring='accuracy', cv=3, verbose=1, n_jobs=-1)

print("Starting GridSearchCV for SVM...")
start_time = time.time()
grid_search_svm.fit(X_train, y_train)
end_time = time.time()

print(f"\nBest Parameters for SVM: {grid_search_svm.best_params_}")

# Evaluate the best model
best_svm = grid_search_svm.best_estimator_
y_pred_svm_tuned = best_svm.predict(X_test)
print(f"Tuned SVM Test Accuracy: {accuracy_score(y_test, y_pred_svm_tuned):.4f}")

print("\nClassification Report for Tuned SVM:")
print(classification_report(y_test, y_pred_svm_tuned, target_names=label_encoder.classes_))
